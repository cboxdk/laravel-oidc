{
    "name": "cboxdk/laravel-oidc",
    "description": "Cbox OIDC: an OpenID Connect relying party for Laravel. Discovery, authorization code flow with PKCE, full ID token verification through web-token, issuer and tenant pinning, refresh, userinfo, logout and back-channel logout, with every outbound call behind the SSRF guard.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "oidc",
        "openid-connect",
        "oauth2",
        "sso",
        "pkce",
        "jwt",
        "security"
    ],
    "authors": [
        {
            "name": "Cbox",
            "homepage": "https://cboxdk.com"
        }
    ],
    "support": {
        "issues": "https://github.com/cboxdk/laravel-oidc/issues",
        "source": "https://github.com/cboxdk/laravel-oidc",
        "security": "https://github.com/cboxdk/laravel-oidc/security/policy"
    },
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "cboxdk/laravel-ssrf": "^1.5",
        "guzzlehttp/guzzle": "^7.8.2 || ^8.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "psr/clock": "^1.0",
        "web-token/jwt-library": "^4.2.3"
    },
    "suggest": {
        "ext-gmp": "Speeds up the big-number arithmetic behind EC and RSA key handling in web-token (brick/math); bcmath works too."
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6",
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0 || ^5.0",
        "rector/rector": "^2.6"
    },
    "bin": [
        "bin/check-licenses.php",
        "bin/generate-sbom.php"
    ],
    "autoload": {
        "psr-4": {
            "Cbox\\Oidc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cbox\\Oidc\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint --test",
        "format": "pint",
        "rector": "rector process",
        "rector:check": "rector process --dry-run",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "test": "pest",
        "license-check": "@php bin/check-licenses.php",
        "sbom": "@php bin/generate-sbom.php",
        "qa": [
            "@lint",
            "@rector:check",
            "@analyse",
            "@test",
            "@license-check",
            "@composer audit"
        ]
    },
    "scripts-descriptions": {
        "lint": "Check code style with Pint without changing files.",
        "format": "Fix code style with Pint.",
        "rector": "Apply the Rector rules.",
        "rector:check": "Fail if Rector would change a file.",
        "analyse": "Run PHPStan (Larastan) at level max.",
        "test": "Run the Pest suites.",
        "license-check": "Fail if any dependency is not permissively licensed (SBOM/compliance gate).",
        "sbom": "Generate a CycloneDX 1.5 SBOM (sbom.json) from composer.lock.",
        "qa": "Run the full quality gate: lint, Rector, static analysis, tests, license check, security audit."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cbox\\Oidc\\OidcServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "audit": {
            "ignore-abandoned": {
                "symplify/rule-doc-generator-contracts": "Dev-only: driftingly/rector-laravel requires it for rule documentation; nothing ships or runs it in production."
            }
        }
    }
}
